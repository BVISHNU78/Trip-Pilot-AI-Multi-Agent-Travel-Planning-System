# Paste these into Streamlit Cloud → your app → Settings → Secrets
# (for local Streamlit runs you can copy this file to .streamlit/secrets.toml, or keep using .env)

GROQ_API_KEY = "your-groq-key"
TAVILY_API = "your-tavily-key"
AVIATIONSTACK_API = "your-aviationstack-key"

# Optional: set to "1" to run the deployed app on fake data with no API calls
# TRAVEL_MOCK = "1"
